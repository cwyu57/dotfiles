#!/bin/sh
set -eu

SCRIPT_NAME=$(basename "$0")
echo "Running script: $SCRIPT_NAME"
echo "🚀 Installing runtime versions..."

OS="{{ .chezmoi.os }}"

if [ "$OS" = "darwin" ]; then
    # Install every tool and version listed in ~/.config/mise/config.toml.
    /opt/homebrew/bin/mise install
elif [ "$OS" = "linux" ]; then
    echo "🚧 Linux detected (not supported yet)"
    exit 1
else
    echo "❌ Unsupported OS: $OS"
    exit 1
fi

echo "✅ Runtime versions install complete!"
echo
