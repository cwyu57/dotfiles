#!/bin/sh
set -eu

SCRIPT_NAME=$(basename "$0")
echo "Running script: $SCRIPT_NAME"
echo "🚀 Installing runtime version manager..."

OS="{{ .chezmoi.os }}"

if [ "$OS" = "darwin" ]; then
    /opt/homebrew/bin/brew install mise
elif [ "$OS" = "linux" ]; then
    echo "🚧 Linux detected (not supported yet)"
    exit 1
else
    echo "❌ Unsupported OS: $OS"
    exit 1
fi

echo "✅ Runtime version manager install complete!"
echo
