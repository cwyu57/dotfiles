[merge]
	tool = juxta

[mergetool]
	keepBackup = false

[mergetool "juxta"]
	cmd = juxta _mergetool --base $BASE --local $LOCAL --remote $REMOTE --merged $MERGED

[pull]
	rebase = true

[commit]
	gpgsign = true

[tag]
	gpgSign = true

# Included path (~/work/.gitconfig) is not managed by chezmoi
[includeIf "gitdir:~/work/"]
	path = ~/work/.gitconfig
